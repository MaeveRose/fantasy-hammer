    "email": "kirkland.rose.maeve@gmail.com",
    "discord": "maeve_rose"
  }],
  "esmodules": [
    "js/utils/sys-const.mjs",
    "js/utils/system-helpers.mjs",
	  "js/utils/GlobalEditor.mjs",
    "fanfliwar.mjs"
    ],
  "styles": [
    "css/common/dialogs.css",
    "css/common/code.css",
    "css/system-styles.css",
    "css/passionsheet.css",
    "css/charactersheet.css",
    "css/talentsheet.css",
    "css/weaponsheet.css",
    "css/armorsheet.css",
    "css/gearsheet.css",
    "css/archetypesheet.css",
