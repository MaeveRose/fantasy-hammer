  }],
  "documentTypes": {
    "Actor":{
      "character":{ "htmlFields": ["background.biography"] },
      "npc":{ "htmlFields": ["background.biography"] },
      "vehicle":{ "htmlFields": ["background.biography"] }
    },
    "Item": {
      "archetype":  { "htmlFields": ["system.description"] },
      "armor":      { "htmlFields": ["system.description"] },
      "gear":       { "htmlFields": ["system.description"] },
      "godgift":    {  },
      "passion":    { "htmlFields": ["system.description"] },
      "spell":      { "htmlFields": ["system.description"] },
      "talent":     { "htmlFields": ["system.description"] },
      "trait":      { "htmlFields": ["system.description"] },
      "weapon":     { "htmlFields": ["system.description"] }
    }
  },
  "socket": false,
  "initiative": "1d10",
  "grid": {
    "distance": 1,
    "units": "m",
    "type":0
  },
  "primaryTokenAttribute": "resources.health",
  "secondaryTokenAttribute": "resources.power",
  "url": "https://your/hosted/system/repo/",
