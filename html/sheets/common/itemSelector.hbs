<div class = "char-selector-wrapper">
    <label>{{localize "global.itemselector.plead"}} {{type}}</label>
    {{#if isAdvanced}} 
    <label>{{localize "global.itemselector.isAdvanced"}}</label>
    {{/if}}
    <select name = "selectedSkill" class = "selector-selection">
        {{selectOptions options selected=this.id valueAttr="id" labelAttr="label"}}
    </select>
</div>